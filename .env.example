# ============================================
# HuntOS Environment Configuration
# Engineered by Niranjan Krishnakumar
# ============================================

# Server Port
PORT=4000

# Client Application URL
CLIENT_URL=http://localhost:5173

# MySQL Database (Local or Cloud like Aiven)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=huntos
DB_PORT=3306
DB_SSL=false

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key (For FastClip, Interview Copilot & ATS Reviewer)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Nodemailer / Gmail SMTP Configuration (For Email Reminders & Alerts)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Twilio WhatsApp Service (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Cloudinary Storage (For PDF/DOCX Resume Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
